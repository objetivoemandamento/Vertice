{
  "name": "vertice-server",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --import=tsx src/server.js",
    "check": "node --check src/server.js && node --check src/db.js && node --check src/markets.js",
    "typecheck": "tsc --noEmit",
    "check:kernel": "tsx --eval \"import './src/security/policyEngine.ts'; import './src/security/schemas.ts';\"",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "bullmq": "^5.58.0",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.8.0",
    "rate-limit-redis": "^4.2.1",
    "zod": "^4.1.5",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "typescript": "^5.9.2"
  }
}
